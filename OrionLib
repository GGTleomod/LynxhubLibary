				local Callback = BindConfig.Callback or function() end
				local Flag = BindConfig.Flag
				local Save = BindConfig.Save or false

				local Bind = {Value = nil, Binding = false, Type = "Bind", Save = Save}
				local Holding = false

				local Click = SetProps(MakeElement("Button"), {
					Size = UDim2.new(1, 0, 1, 0)
				})

				local BindLabel = AddThemeObject(SetProps(MakeElement("Label", "", 13), {
