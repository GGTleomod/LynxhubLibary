						Font = Enum.Font.GothamBold,
						Name = "Content"
					}), "Text"),
					AddThemeObject(MakeElement("Stroke", nil, 1, 0.45), "Stroke"),
					BindBox,
					Click
				}), "Second")

				AddConnection(BindLabel:GetPropertyChangedSignal("TextBounds"), function()
					local BoxWidth = math.max(BindLabel.TextBounds.X + 16, 36)
					TweenService:Create(BindBox, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
						Size = UDim2.new(0, BoxWidth, 0, 24)
					}):Play()
				end)

				AddConnection(Click.MouseButton1Click, function()
					if Bind.Binding then
						return
					end
					Bind.Binding = true
					BindLabel.Text = "..."
				end)

				AddConnection(UserInputService.InputBegan, function(Input, GameProcessed)
					if GameProcessed or UserInputService:GetFocusedTextBox() then
						return
					end

					local InputKeyName = Input.KeyCode and Input.KeyCode.Name or ""
					local InputTypeName = Input.UserInputType and Input.UserInputType.Name or ""

					if not Bind.Binding then
						if (InputKeyName == Bind.Value or InputTypeName == Bind.Value) and Bind.Value ~= "Unknown" then
							if Hold then
								Holding = true
								pcall(Callback, Holding)
							else
								pcall(Callback)
							end
						end
					else
						local Chosen = nil
						if not CheckKey(BlacklistedKeys, Input.KeyCode) and Input.KeyCode ~= Enum.KeyCode.Unknown then
							Chosen = Input.KeyCode
						elseif CheckKey(WhitelistedMouse, Input.UserInputType) then
							Chosen = Input.UserInputType
						end
						Bind:Set(Chosen or Bind.Value)
						SaveCfg(game.GameId)
					end
				end)

				AddConnection(UserInputService.InputEnded, function(Input)
					local InputKeyName = Input.KeyCode and Input.KeyCode.Name or ""
					local InputTypeName = Input.UserInputType and Input.UserInputType.Name or ""
					if (InputKeyName == Bind.Value or InputTypeName == Bind.Value) and Hold and Holding then
						Holding = false
						pcall(Callback, Holding)
					end
				end)

				function Bind:Set(Key)
					Bind.Binding = false
					if typeof(Key) == "EnumItem" then
						Bind.Value = Key.Name
					else
						Bind.Value = tostring(Key or "Unknown")
					end
					BindLabel.Text = Bind.Value
				end

				Bind:Set(Default)
				if Flag then
					OrionLib.Flags[Flag] = Bind
				end
				return Bind
			end

			function ElementFunction:AddTextbox(TextboxConfig)
				TextboxConfig = TextboxConfig or {}
				local TbxName = TextboxConfig.Name or "Textbox"
				local Default = TextboxConfig.Default or ""
				local TextDisappear = TextboxConfig.TextDisappear or false
				local Callback = TextboxConfig.Callback or function() end

				local TextboxActual = AddThemeObject(Create("TextBox", {
					Size = UDim2.new(1, -10, 1, 0),
					Position = UDim2.new(0, 5, 0, 0),
					BackgroundTransparency = 1,
					PlaceholderColor3 = Color3.fromRGB(180, 180, 180),
					PlaceholderText = "Input",
					Font = Enum.Font.GothamSemibold,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextSize = 13,
					ClearTextOnFocus = false
				}), "Text")

				local TextContainer = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", nil, 0, 4, 0.72), {
					Size = UDim2.new(0, 90, 0, 24),
					Position = UDim2.new(1, -12, 0.5, 0),
					AnchorPoint = Vector2.new(1, 0.5)
				}), {
					AddThemeObject(MakeElement("Stroke", nil, 1, 0.45), "Stroke"),
					TextboxActual
				}), "Main")

				AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", nil, 0, 5, 0.85), {
					Size = UDim2.new(1, 0, 0, 38),
					Parent = ItemParent
				}), {
					AddThemeObject(SetProps(MakeElement("Label", TbxName, 15), {
						Size = UDim2.new(1, -120, 1, 0),
						Position = UDim2.new(0, 12, 0, 0),
						Font = Enum.Font.GothamBold,
						Name = "Content"
					}), "Text"),
					AddThemeObject(MakeElement("Stroke", nil, 1, 0.45), "Stroke"),
					TextContainer
				}), "Second")

				AddConnection(TextboxActual:GetPropertyChangedSignal("TextBounds"), function()
					local DesiredWidth = math.clamp(TextboxActual.TextBounds.X + 20, 70, 180)
					TweenService:Create(TextContainer, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
						Size = UDim2.new(0, DesiredWidth, 0, 24)
					}):Play()
				end)

				AddConnection(TextboxActual.FocusLost, function()
					local CurrentText = TextboxActual.Text
					pcall(Callback, CurrentText)
					if TextDisappear then
						TextboxActual.Text = ""
					end
				end)

				TextboxActual.Text = tostring(Default)

				return {
					Set = function(_, NewText)
						TextboxActual.Text = tostring(NewText or "")
					end,
					Get = function()
						return TextboxActual.Text
					end
				}
			end

			function ElementFunction:AddColorpicker(ColorpickerConfig)
				ColorpickerConfig = ColorpickerConfig or {}
				local CpName = ColorpickerConfig.Name or "Colorpicker"
				local Default = ColorpickerConfig.Default or Color3.fromRGB(255, 255, 255)
				local Callback = ColorpickerConfig.Callback or function() end
				local Flag = ColorpickerConfig.Flag
				local Save = ColorpickerConfig.Save or false

				local HueVal, SatVal, ValVal = Color3.toHSV(Default)
				local Colorpicker = {
					Value = Default,
					Toggled = false,
					Type = "Colorpicker",
					Save = Save
				}

				local ColorInputConn = nil
				local HueInputConn = nil

				local ColorSelection = Create("Frame", {
					Size = UDim2.new(0, 12, 0, 12),
					Position = UDim2.new(SatVal, 0, 1 - ValVal, 0),
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 1
				}, {
					Create("UICorner", {CornerRadius = UDim.new(1, 0)})
				})

				local HueSelection = Create("Frame", {
					Size = UDim2.new(1, 4, 0, 6),
					Position = UDim2.new(0.5, 0, 1 - HueVal, 0),
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 1
				}, {
					Create("UICorner", {CornerRadius = UDim.new(0, 3)})
				})

				local Color = Create("Frame", {
					Size = UDim2.new(1, -28, 1, 0),
					Visible = false,
					BackgroundColor3 = Color3.fromHSV(HueVal, 1, 1),
					BorderSizePixel = 0
				}, {
					Create("UICorner", {CornerRadius = UDim.new(0, 5)}),
					ColorSelection
				})

				local Hue = Create("Frame", {
					Size = UDim2.new(0, 20, 1, 0),
					Position = UDim2.new(1, -20, 0, 0),
					Visible = false,
					BorderSizePixel = 0
				}, {
					Create("UIGradient", {
						Rotation = 270,
						Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 4)),
							ColorSequenceKeypoint.new(0.20, Color3.fromRGB(234, 255, 0)),
							ColorSequenceKeypoint.new(0.40, Color3.fromRGB(21, 255, 0)),
							ColorSequenceKeypoint.new(0.60, Color3.fromRGB(0, 255, 255)),
							ColorSequenceKeypoint.new(0.80, Color3.fromRGB(0, 17, 255)),
							ColorSequenceKeypoint.new(0.90, Color3.fromRGB(255, 0, 251)),
							ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 4))
						})
					}),
					Create("UICorner", {CornerRadius = UDim.new(0, 5)}),
					HueSelection
				})

				local ColorpickerContainer = Create("Frame", {
					Position = UDim2.new(0, 0, 0, 38),
					Size = UDim2.new(1, 0, 1, -38),
					BackgroundTransparency = 1,
					ClipsDescendants = true
				}, {
					Hue,
					Color,
					Create("UIPadding", {
						PaddingLeft = UDim.new(0, 12),
						PaddingRight = UDim.new(0, 12),
						PaddingBottom = UDim.new(0, 10),
						PaddingTop = UDim.new(0, 10)
					})
				})

				local Click = SetProps(MakeElement("Button"), {
					Size = UDim2.new(1, 0, 1, 0)
				})

				local ColorpickerBox = SetChildren(SetProps(MakeElement("RoundFrame", Default, 0, 4, 0.25), {
					Size = UDim2.new(0, 24, 0, 24),
					Position = UDim2.new(1, -12, 0.5, 0),
					AnchorPoint = Vector2.new(1, 0.5)
				}), {
					AddThemeObject(MakeElement("Stroke", nil, 1, 0.45), "Stroke")
				})

				local LineFrame = AddThemeObject(SetProps(MakeElement("Frame"), {
					Size = UDim2.new(1, 0, 0, 1),
					Position = UDim2.new(0, 0, 1, -1),
					BackgroundTransparency = 0.65,
					Name = "Line",
					Visible = false
				}), "Stroke")

				local HeaderFrame = SetChildren(SetProps(MakeElement("TFrame"), {
					Size = UDim2.new(1, 0, 0, 38),
					ClipsDescendants = true,
					Name = "F"
				}), {
					AddThemeObject(SetProps(MakeElement("Label", CpName, 15), {
						Size = UDim2.new(1, -60, 1, 0),
						Position = UDim2.new(0, 12, 0, 0),
						Font = Enum.Font.GothamBold,
						Name = "Content"
					}), "Text"),
					ColorpickerBox,
					LineFrame,
					Click
				})

				local ColorpickerFrame = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", nil, 0, 5, 0.85), {
					Size = UDim2.new(1, 0, 0, 38),
					Parent = ItemParent,
					ClipsDescendants = true
				}), {
					HeaderFrame,
					ColorpickerContainer,
					AddThemeObject(MakeElement("Stroke", nil, 1, 0.45), "Stroke")
				}), "Second")

				AddConnection(Click.MouseButton1Click, function()
					Colorpicker.Toggled = not Colorpicker.Toggled
					TweenService:Create(ColorpickerFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = Colorpicker.Toggled and UDim2.new(1, 0, 0, 148) or UDim2.new(1, 0, 0, 38)
					}):Play()
					Color.Visible = Colorpicker.Toggled
					Hue.Visible = Colorpicker.Toggled
					LineFrame.Visible = Colorpicker.Toggled
				end)

				local function DisconnectColor()
					if ColorInputConn and ColorInputConn.Connected then
						ColorInputConn:Disconnect()
						ColorInputConn = nil
					end
				end

				local function DisconnectHue()
					if HueInputConn and HueInputConn.Connected then
						HueInputConn:Disconnect()
						HueInputConn = nil
					end
				end

				AddConnection(Color.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 and Mouse then
						DisconnectColor()
						ColorInputConn = AddConnection(RunService.RenderStepped, function()
							local CW = math.max(Color.AbsoluteSize.X, 1)
							local CH = math.max(Color.AbsoluteSize.Y, 1)
							local ColorX = math.clamp((Mouse.X - Color.AbsolutePosition.X) / CW, 0, 1)
							local ColorY = math.clamp((Mouse.Y - Color.AbsolutePosition.Y) / CH, 0, 1)
							ColorSelection.Position = UDim2.new(ColorX, 0, ColorY, 0)
							SatVal = ColorX
							ValVal = 1 - ColorY
							local NewCol = Color3.fromHSV(HueVal, SatVal, ValVal)
							Colorpicker:Set(NewCol)
							SaveCfg(game.GameId)
						end)
					end
				end)

				AddConnection(Color.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						DisconnectColor()
					end
				end)

				AddConnection(Hue.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 and Mouse then
						DisconnectHue()
						HueInputConn = AddConnection(RunService.RenderStepped, function()
							local HH = math.max(Hue.AbsoluteSize.Y, 1)
							local HueY = math.clamp((Mouse.Y - Hue.AbsolutePosition.Y) / HH, 0, 1)
							HueSelection.Position = UDim2.new(0.5, 0, HueY, 0)
							HueVal = 1 - HueY
							Color.BackgroundColor3 = Color3.fromHSV(HueVal, 1, 1)
							local NewCol = Color3.fromHSV(HueVal, SatVal, ValVal)
							Colorpicker:Set(NewCol)
							SaveCfg(game.GameId)
						end)
					end
				end)

				AddConnection(Hue.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						DisconnectHue()
					end
				end)

				function Colorpicker:Set(Value)
					if typeof(Value) == "Color3" then
						Colorpicker.Value = Value
						HueVal, SatVal, ValVal = Color3.toHSV(Value)
						ColorpickerBox.BackgroundColor3 = Value
						Color.BackgroundColor3 = Color3.fromHSV(HueVal, 1, 1)
						ColorSelection.Position = UDim2.new(SatVal, 0, 1 - ValVal, 0)
						HueSelection.Position = UDim2.new(0.5, 0, 1 - HueVal, 0)
						pcall(Callback, Colorpicker.Value)
					end
				end

				Colorpicker:Set(Colorpicker.Value)
				if Flag then
					OrionLib.Flags[Flag] = Colorpicker
				end
				return Colorpicker
			end

			return ElementFunction
		end

		local ElementFunction = {}

		function ElementFunction:AddSection(SectionConfig)
			SectionConfig = SectionConfig or {}
			local SecName = SectionConfig.Name or "Section"

			local Holder = SetChildren(SetProps(MakeElement("TFrame"), {
				AnchorPoint = Vector2.new(0, 0),
				Size = UDim2.new(1, 0, 0, 0),
				Position = UDim2.new(0, 0, 0, 23),
				Name = "Holder"
			}), {
				MakeElement("List", 0, 6)
			})

			local SectionFrame = SetChildren(SetProps(MakeElement("TFrame"), {
				Size = UDim2.new(1, 0, 0, 26),
				Parent = Container
			}), {
				AddThemeObject(SetProps(MakeElement("Label", SecName, 14), {
					Size = UDim2.new(1, -12, 0, 16),
					Position = UDim2.new(0, 0, 0, 3),
					Font = Enum.Font.GothamSemibold
				}), "TextDark"),
				Holder
			})

			AddConnection(Holder.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
				local ContentY = Holder.UIListLayout.AbsoluteContentSize.Y
				SectionFrame.Size = UDim2.new(1, 0, 0, ContentY + 31)
				Holder.Size = UDim2.new(1, 0, 0, ContentY)
			end)

			local SectionFunction = {}
			for Key, Fn in pairs(GetElements(Holder)) do
				SectionFunction[Key] = Fn
			end
			return SectionFunction
		end

		for Key, Fn in pairs(GetElements(Container)) do
			ElementFunction[Key] = Fn
		end

		if PremiumOnly then
			for Key in pairs(ElementFunction) do
				ElementFunction[Key] = function() end
			end
			if Container:FindFirstChild("UIListLayout") then
				Container.UIListLayout:Destroy()
			end
			if Container:FindFirstChild("UIPadding") then
				Container.UIPadding:Destroy()
			end
			SetChildren(SetProps(MakeElement("TFrame"), {
				Size = UDim2.new(1, 0, 1, 0),
				Parent = Container
			}), {
				AddThemeObject(SetProps(MakeElement("Label", "Gesperrt", 14), {
					Size = UDim2.new(1, -38, 0, 14),
					Position = UDim2.new(0, 18, 0, 18),
					TextTransparency = 0.4
				}), "Text"),
				AddThemeObject(SetProps(MakeElement("Label", "Lynx Hub", 14), {
					Size = UDim2.new(1, -150, 0, 14),
					Position = UDim2.new(0, 18, 0, 112),
					Font = Enum.Font.GothamBold
				}), "Text"),
				AddThemeObject(SetProps(MakeElement("Label", "Dieser Bereich ist gesperrt.", 12), {
					Size = UDim2.new(1, -40, 0, 28),
					Position = UDim2.new(0, 18, 0, 138),
					TextWrapped = true,
					TextTransparency = 0.4
				}), "Text")
			})
		end

		return ElementFunction
	end

	OrionLib:MakeNotification({
		Name = "Lynx Hub",
		Content = "Beta geladen.",
		Time = 4
	})

	return TabFunction
end

function OrionLib:Destroy()
	for _, Connection in ipairs(OrionLib.Connections) do
		if Connection and Connection.Connected then
			Connection:Disconnect()
		end
	end
	table.clear(OrionLib.Connections)
	if OrionGui then
		OrionGui:Destroy()
	end
end

return OrionLib
