					Size = UDim2.new(0, 0, 1, 0),
					ClipsDescendants = true
				}), {
					DragValueLabel
				})

				local BarValueLabel = AddThemeObject(SetProps(MakeElement("Label", "", 13), {
					Size = UDim2.new(1, -12, 0, 14),
					Position = UDim2.new(0, 12, 0, 6),
					Font = Enum.Font.GothamBold,
					Name = "Value",
					TextTransparency = 0.65
				}), "Text")

				local SliderBar = SetChildren(SetProps(MakeElement("RoundFrame", SliderColor, 0, 5, 0.9), {
					Size = UDim2.new(1, -24, 0, 26),
					Position = UDim2.new(0, 12, 0, 30)
				}), {
					SetProps(MakeElement("Stroke", nil, 1, 0.4), {Color = SliderColor}),
					BarValueLabel,
					SliderDrag
				})

				AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", nil, 0, 4, 0.85), {
					Size = UDim2.new(1, 0, 0, 65),
					Parent = ItemParent
				}), {
					AddThemeObject(SetProps(MakeElement("Label", SldName, 15), {
						Size = UDim2.new(1, -12, 0, 14),
						Position = UDim2.new(0, 12, 0, 10),
						Font = Enum.Font.GothamBold,
						Name = "Content"
					}), "Text"),
					AddThemeObject(MakeElement("Stroke", nil, 1, 0.45), "Stroke"),
					SliderBar
				}), "Second")

				AddConnection(SliderBar.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						Dragging = true
					end
				end)

				AddConnection(SliderBar.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then
						Dragging = false
					end
				end)

				AddConnection(UserInputService.InputChanged, function(Input)
					if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
						local Width = math.max(SliderBar.AbsoluteSize.X, 1)
						local SizeScale = math.clamp((Input.Position.X - SliderBar.AbsolutePosition.X) / Width, 0, 1)
						Slider:Set(Min + ((Max - Min) * SizeScale))
						SaveCfg(game.GameId)
					end
				end)

				function Slider:Set(Value)
					local Step = math.max(Increment, 0.0001)
					self.Value = math.clamp(Round(Value, Step), Min, Max)
					local Span = math.max(Max - Min, 0.0001)
					local Scale = math.clamp((self.Value - Min) / Span, 0, 1)
					TweenService:Create(SliderDrag, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = UDim2.fromScale(Scale, 1)
					}):Play()
					local Formatted = tostring(self.Value) .. (ValueName ~= "" and (" " .. ValueName) or "")
					BarValueLabel.Text = Formatted
					DragValueLabel.Text = Formatted
					pcall(Callback, self.Value)
				end

				Slider:Set(Slider.Value)
				if Flag then
					OrionLib.Flags[Flag] = Slider
				end
				return Slider
			end

