					for _, Option in ipairs(OptionList) do
						local TitleLbl = AddThemeObject(SetProps(MakeElement("Label", tostring(Option), 13, 0.4), {
							Position = UDim2.new(0, 8, 0, 0),
							Size = UDim2.new(1, -8, 1, 0),
							Name = "Title"
						}), "Text")

						local OptionBtn = AddThemeObject(SetProps(SetChildren(MakeElement("Button"), {
							MakeElement("Corner", 0, 6),
							TitleLbl
						}), {
							Parent = DropdownContainer,
							Size = UDim2.new(1, 0, 0, 28),
							BackgroundTransparency = 1,
							ClipsDescendants = true
						}), "Second")

						AddConnection(OptionBtn.MouseButton1Click, function()
							Dropdown:Set(Option)
							SaveCfg(game.GameId)
						end)

						Dropdown.Buttons[Option] = OptionBtn
					end
				end

				function Dropdown:Refresh(NewOptions, Delete)
					if Delete then
						for _, Btn in pairs(Dropdown.Buttons) do
							if Btn then
								Btn:Destroy()
							end
						end
						table.clear(Dropdown.Options)
						table.clear(Dropdown.Buttons)
					end
					Dropdown.Options = table.clone(NewOptions or {})
					AddOptions(Dropdown.Options)
				end

				function Dropdown:Set(Value)
					if not table.find(Dropdown.Options, Value) then
						Dropdown.Value = "..."
						SelectedLabel.Text = Dropdown.Value
						for _, Btn in pairs(Dropdown.Buttons) do
							TweenService:Create(Btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
							if Btn:FindFirstChild("Title") then
								TweenService:Create(Btn.Title, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0.4}):Play()
							end
						end
						return
					end

					Dropdown.Value = Value
					SelectedLabel.Text = tostring(Dropdown.Value)

					for _, Btn in pairs(Dropdown.Buttons) do
						TweenService:Create(Btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
						if Btn:FindFirstChild("Title") then
							TweenService:Create(Btn.Title, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0.4}):Play()
						end
					end

					local ActiveBtn = Dropdown.Buttons[Value]
					if ActiveBtn then
						TweenService:Create(ActiveBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.72}):Play()
						if ActiveBtn:FindFirstChild("Title") then
							TweenService:Create(ActiveBtn.Title, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
						end
					end

					pcall(Callback, Dropdown.Value)
				end

				AddConnection(Click.MouseButton1Click, function()
					Dropdown.Toggled = not Dropdown.Toggled
					LineFrame.Visible = Dropdown.Toggled
					TweenService:Create(ArrowLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Rotation = Dropdown.Toggled and 180 or 0
					}):Play()

					local TargetHeight = 38
					if Dropdown.Toggled then
						if #Dropdown.Options > MaxElements then
							TargetHeight = 38 + (MaxElements * 28)
						else
							TargetHeight = DropdownList.AbsoluteContentSize.Y + 38
						end
					end

					TweenService:Create(DropdownFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = UDim2.new(1, 0, 0, TargetHeight)
					}):Play()
				end)

				Dropdown:Refresh(Dropdown.Options, false)
				Dropdown:Set(Dropdown.Value)

				if Flag then
					OrionLib.Flags[Flag] = Dropdown
				end
				return Dropdown
			end

