function OrionLib:MakeNotification(NotificationConfig)
	NotificationConfig = NotificationConfig or {}
	local Name = NotificationConfig.Name or "Lynx Hub"
	local Content = NotificationConfig.Content or ""
	local Duration = NotificationConfig.Time or 5

	task.spawn(function()
		local NotificationParent = SetProps(MakeElement("TFrame"), {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = NotificationHolder
		})

		local StrokeObj = AddThemeObject(MakeElement("Stroke", nil, 1, 0.35), "Stroke")
		local TitleLabel = AddThemeObject(SetProps(MakeElement("Label", Name, 15), {
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.new(0, 0, 0, 0),
			Font = Enum.Font.GothamBold,
			Name = "Title"
		}), "Text")
		local ContentLabel = AddThemeObject(SetProps(MakeElement("Label", Content, 14), {
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.new(0, 0, 0, 24),
			Font = Enum.Font.GothamSemibold,
			Name = "Content",
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true
		}), "TextDark")

		local NotificationFrame = AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame", nil, 0, 10, 0.65), {
			Parent = NotificationParent,
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.new(1, 320, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y
		}), {
			StrokeObj,
			MakeElement("Padding", 12, 12, 12, 12),
			TitleLabel,
			ContentLabel
		}), "Main")

		TweenService:Create(
			NotificationFrame,
			TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{Position = UDim2.new(0, 0, 0, 0)}
		):Play()

		task.wait(math.max(Duration - 0.8, 0.2))

		if not NotificationFrame.Parent then
			return
		end

		TweenService:Create(NotificationFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {BackgroundTransparency = 0.95}):Play()
		TweenService:Create(StrokeObj, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {Transparency = 0.9}):Play()
		TweenService:Create(TitleLabel, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {TextTransparency = 0.8}):Play()
		TweenService:Create(ContentLabel, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {TextTransparency = 0.8}):Play()

		task.wait(0.35)
		if NotificationParent.Parent then
			NotificationParent:Destroy()
		end
	end)
end

function OrionLib:Init()
	if OrionLib.SaveCfg and OrionLib.Folder and type(isfile) == "function" and type(readfile) == "function" then
		pcall(function()
			local Path = OrionLib.Folder .. "/" .. tostring(game.GameId) .. ".txt"
			if isfile(Path) then
				LoadCfg(readfile(Path))
				OrionLib:MakeNotification({
					Name = "Lynx Hub",
					Content = "Config geladen.",
					Time = 4
				})
			end
		end)
	end
end

